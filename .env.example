# Copy this file to .env, then fill in your own YAZIO account credentials.
YAZIO_USERNAME=
YAZIO_PASSWORD=

YAZIO_API_BASE_URL=https://yzapi.yazio.com/v22

# Observed mobile-app version, not a stable public API value. If YAZIO returns
# version_blocked, replace it with a currently accepted User-Agent.
YAZIO_USER_AGENT="YAZIO/26.30.1 (com.yazio.ios.YAZIO; build:2607271240; iOS 27.0.0) Ktor"

YAZIO_CONNECT_TIMEOUT_SECONDS=5
YAZIO_READ_TIMEOUT_SECONDS=30
